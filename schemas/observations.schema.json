{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Nitmi/board-registry/schemas/observations.schema.json",
  "title": "Embedded Board Observations",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "observations"],
  "properties": {
    "schema_version": {
      "const": "embedded-board-registry.observations.v1"
    },
    "observations": {
      "type": "array",
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/serialObservation"},
          {"$ref": "#/$defs/debugObservation"},
          {"$ref": "#/$defs/bleObservation"}
        ]
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "point_in_time"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "point_in_time": {"type": "boolean"}
      }
    },
    "serialObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "transport", "identity", "source"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "transport": {"const": "serial"},
        "identity": {"$ref": "registry.schema.json#/$defs/serialIdentity"},
        "source": {"$ref": "#/$defs/source"}
      }
    },
    "debugObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "transport", "identity", "source"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "transport": {"const": "debug"},
        "identity": {"$ref": "registry.schema.json#/$defs/debugIdentity"},
        "source": {"$ref": "#/$defs/source"}
      }
    },
    "bleObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "transport", "identity", "source"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "transport": {"const": "ble"},
        "identity": {"$ref": "registry.schema.json#/$defs/bleIdentity"},
        "source": {"$ref": "#/$defs/source"}
      }
    }
  }
}
