{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Nitmi/board-registry/schemas/registry.schema.json",
  "title": "Embedded Board Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "boards"],
  "properties": {
    "schema_version": {
      "const": "embedded-board-registry.registry.v1"
    },
    "boards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "selectors"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "selectors": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/selector"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "selector": {
      "oneOf": [
        {
          "$ref": "#/$defs/serialSelector"
        },
        {
          "$ref": "#/$defs/debugSelector"
        },
        {
          "$ref": "#/$defs/bleSelector"
        }
      ]
    },
    "selectorBase": {
      "type": "object",
      "required": ["id", "transport", "identity"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        }
      }
    },
    "serialSelector": {
      "allOf": [
        {
          "$ref": "#/$defs/selectorBase"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": true,
            "transport": {
              "const": "serial"
            },
            "identity": {
              "$ref": "#/$defs/serialIdentity"
            }
          }
        }
      ]
    },
    "debugSelector": {
      "allOf": [
        {
          "$ref": "#/$defs/selectorBase"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": true,
            "transport": {
              "const": "debug"
            },
            "identity": {
              "$ref": "#/$defs/debugIdentity"
            }
          }
        }
      ]
    },
    "bleSelector": {
      "allOf": [
        {
          "$ref": "#/$defs/selectorBase"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": true,
            "transport": {
              "const": "ble"
            },
            "identity": {
              "$ref": "#/$defs/bleIdentity"
            }
          }
        }
      ]
    },
    "serialIdentity": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "port": {"type": "string", "minLength": 1},
        "usb_vid": {"type": "string", "minLength": 1},
        "usb_pid": {"type": "string", "minLength": 1},
        "usb_serial": {"type": "string", "minLength": 1},
        "pnp_interface": {"type": "string", "minLength": 1}
      }
    },
    "debugIdentity": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "probe_selector": {"type": "string", "minLength": 1},
        "vendor_id": {"type": "string", "minLength": 1},
        "product_id": {"type": "string", "minLength": 1},
        "serial_number": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1}
      }
    },
    "bleIdentity": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "identifier": {"type": "string", "minLength": 1},
        "local_name": {"type": "string", "minLength": 1},
        "service_uuid": {"type": "string", "minLength": 1},
        "manufacturer_id": {"type": "string", "minLength": 1}
      }
    }
  }
}
